<?xml version="1.0" encoding="utf-8"?>
<androidx.slidingpanelayout.widget.SlidingPaneLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slidingPaneLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- List Pane (Menu) -->
    <LinearLayout
        android:id="@+id/listPane"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/menuDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="📦 设备信息"
            android:textSize="18sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/menuSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="🌐 网络同步"
            android:textSize="18sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/menuBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="💾 备份恢复"
            android:textSize="18sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/menuMaintenance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="🛠️ 系统维护"
            android:textSize="18sp"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

    <!-- Detail Pane (Details) -->
    <RelativeLayout
        android:id="@+id/detailPane"
        android:layout_width="500dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#FFFFFF">

        <FrameLayout
            android:id="@+id/detailContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/btnConfirmSave"
            android:padding="24dp" />

        <Button
            android:id="@+id/btnConfirmSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentBottom="true"
            android:layout_margin="16dp"
            android:text="确认保存"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_rounded"
            android:textColor="#FFFFFF" />

    </RelativeLayout>
</androidx.slidingpanelayout.widget.SlidingPaneLayout>
